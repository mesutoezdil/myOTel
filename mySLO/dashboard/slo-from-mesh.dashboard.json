{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sli:availability:ratio_rate5m{workload=\"orders-api\"}",
          "refId": "A"
        }
      ],
      "title": "orders-api availability (5m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sli:availability:ratio_rate5m{workload_ns=~\"$workload_ns\"}",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "Availability \u2014 inbound success rate per service (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sli:request:rate5m{workload_ns=~\"$workload_ns\"}",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "Request rate per service (SLO 4: traffic floor)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "(1 - sli:availability:ratio_rate1h{workload_ns=~\"$workload_ns\"}) / (1 - 0.999)",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "Error budget burn rate (1h, 99.9% target)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (workload, le) (rate(response_latency_ms_bucket{direction=\"inbound\", target_port!=\"4191\", workload_ns=~\"$workload_ns\"}[5m])))",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "p95 inbound latency per service (ms)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (workload, le) (rate(response_latency_ms_bucket{direction=\"inbound\", target_port!=\"4191\", workload_ns=~\"$workload_ns\"}[5m])))",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "p99 inbound latency per service (ms)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "linkerd",
    "slo"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "name": "workload_ns",
        "query": "label_values(response_total{direction=\"inbound\"}, workload_ns)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "SLOs from mesh metrics",
  "uid": "slo-from-mesh",
  "version": 2
}